# ═════════════════════════════════════════════
# MokTradeDesk — Environment Variables
# ═════════════════════════════════════════════
# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید

# ─── Backend ───
# آدرس سرور بک‌اند
API_BASE_URL=http://localhost:8000

# دیتابیس (پیش‌فرض SQLite)
DATABASE_URL=sqlite:///./app.db

# ─── Frontend ───
# آدرس API (برای فرانت‌اند)
VITE_API_BASE_URL=http://localhost:8000

# ─── Security ───
# کلید رمزگذاری (برای جلسات و توکن‌ها)
SECRET_KEY=change-me-to-a-random-string

# ─── Logging ───
# سطح لاگ: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/app.log